# ============================================================
# ANDRO PRIME — Environment Variables
# Copy this file to .env.local and fill in values.
# Never commit .env.local — it is gitignored.
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://andro-prime.com

# --- Supabase (Ireland region — mandatory for UK GDPR) ---
# Supabase has renamed ANON_KEY to PUBLISHABLE_KEY — both work; use whichever your dashboard shows
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ClickUp (content-review sign-off gate) ---
# Personal API token. Used by the content-engine agents (and any review-task tooling)
# to create/read tasks on the "Content Review — Ewa" list (901218140081). Set in the
# cloud agent runtime; kept in .env.local for local dev. Rotate in ClickUp if leaked.
CLICKUP_API_TOKEN=

# --- Blog revalidation (DB-backed blog) ---
# Shared secret for POST /api/revalidate, sent as the `x-revalidate-secret` header.
# The blog_articles Supabase Database Webhook (and the Publisher agent) use it to
# refresh published/edited/archived articles with no Coolify redeploy. Route fails
# closed (401) when unset, so set this in Coolify before wiring the DB webhook.
REVALIDATE_SECRET=

# Shared token gating the draft preview route (/blog/preview/<slug>?token=...), the
# G2 sign-off review surface Ewa opens from the ClickUp task. Preview 404s when unset.
PREVIEW_SECRET=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (copy from Stripe Dashboard → Catalogue → Products → [product] → Pricing)
STRIPE_PRICE_KIT_1=
STRIPE_PRICE_KIT_2=
STRIPE_PRICE_KIT_3=
STRIPE_PRICE_DAILY_STACK=
STRIPE_PRICE_COLLAGEN=
STRIPE_PRICE_COMPLETE_STACK=

# Stripe Coupon IDs for auto-applied ?discount= codes (Dashboard → Product catalogue → Coupons → [coupon] → copy ID).
# Mode-specific — set the LIVE coupon IDs in Coolify; leave blank locally so test checkouts stay full price.
STRIPE_COUPON_SUBSCRIBER10=
STRIPE_COUPON_LAUNCHDAY10=

# --- Vitall (lab partner) ---
# OAuth 2.0 credentials — obtain from Vitall onboarding
VITALL_CLIENT_ID=
VITALL_CLIENT_SECRET=
# Webhook signing token — obtain from Vitall; used to verify HMAC-256 signatures
VITALL_WEBHOOK_SECRET=
# Set to "true" to route all Vitall API calls to vitallsync.com sandbox
VITALL_SANDBOX=false

# --- Customer.io (email / CRM) ---
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=
CUSTOMERIO_APP_API_KEY=
# Track API region. EU is the DEFAULT in code (fail-safe: we are a UK controller and
# these events carry consent-gated health-derived traits). Set to "false" only to
# target the US data centre deliberately. MUST ALSO BE SET IN COOLIFY: it was absent
# there until 2026-08-04, which sent live production events via the US endpoints.
CUSTOMERIO_EU=true
# Internal ops alert recipient (lab-cancellation alert etc). Defaults to
# keith@andro-prime.com in code if unset.
OPS_ALERT_EMAIL=

# --- FirstPromoter (affiliate tracking) ---
FIRSTPROMOTER_API_KEY=
NEXT_PUBLIC_FIRSTPROMOTER_TRACKING_ID=

# --- Upstash QStash (webhook job queue) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Sentry (error monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Analytics ---
# Plausible: configured via script tag — no server-side key needed for basic setup
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=andro-prime.com
# GA4 server-side events (Measurement Protocol mirror — runs cookie-free, no consent)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# GA4 client-side tag (gtag.js, consent-gated). Same G-XXXX id as above; exposed to
# the browser (the measurement id is not secret). Leave unset to disable client GA
# entirely — the cookie banner then does not render. The api_secret is NEVER public.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Meta Conversions API (server-side events only)
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Link-in-bio grid for the 30-day Instagram carousel run (/go, lib/bio-grid.ts).
# When day 1 PUBLISHES. Bare date (2026-09-01, read as 00:00 UTC) or full ISO instant
# (2026-09-01T08:00:00Z). SET IT TO THE LATEST SLOT TIME YOU WILL EVER POST AT: tiles
# are revealed in whole 24h periods from this instant, so anchoring at midnight while
# posts go out at 08:00 shows every tile up to 8h before its carousel exists. Anchored
# late, a tile can only appear slightly late, which nobody notices.
# UNSET or future renders an empty grid rather than exposing the unposted schedule.
# Must be set in Coolify before the run starts, or the bio link lands on an empty page.
CAROUSEL_RUN_START=
