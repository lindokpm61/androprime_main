# ============================================================
# ANDRO PRIME — Environment Variables
# Copy this file to .env.local and fill in values.
# Never commit .env.local — it is gitignored.
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://andro-prime.com

# The app host. ONE Next.js app is served on TWO hostnames (lib/hosts.ts is the
# single source of truth for which routes go where), and the middleware builds
# ABSOLUTE redirects from this value.
#
# LOCALLY THIS IS NOT OPTIONAL, and the failure is ugly rather than obvious.
# Unset, it falls back to the https:// production host, and every app-host route
# (/auth, /account, /results-dashboard, /subscriptions, ...) 308s to a URL the
# dev server cannot serve. What you see is a redirect loop on every gated route
# while the marketing routes look fine, which reads like a middleware bug.
#
# 🔴 IT HAS TO BE IN `.env.local`. PASSING IT ON THE `npm run dev` COMMAND LINE
# DOES NOT WORK (found 2026-09-12), and it fails in the most misleading way
# available: `lib/hosts.ts` is imported by `middleware.ts`, which compiles to the
# EDGE runtime, and a NEXT_PUBLIC_* value is inlined there from the env FILES
# rather than read from the shell environment. A flag passed on the same command
# line (MEMBERSHIP_ENABLED, read in a server component) arrives perfectly, so the
# env appears to be working while the middleware still holds the https:// default
# and every gated route loops. The line above used to say the opposite.
#
#   .env.local  ->  NEXT_PUBLIC_APP_URL=http://app.andro-prime.com
#
# Do NOT set it to http://localhost:3000: that makes the app host and the apex
# the same origin and the marketing routes loop instead. There is no single
# origin that serves both halves, by design. `scripts/route-conformance.js`
# carries the full note, including the Chrome --host-resolver-rules it needs.
# Added here 2026-09-12 after a session lost an hour to the loop; the rule had
# only ever been written inside that script.
NEXT_PUBLIC_APP_URL=https://app.andro-prime.com

# --- Supabase (Ireland region — mandatory for UK GDPR) ---
# Supabase has renamed ANON_KEY to PUBLISHABLE_KEY — both work; use whichever your dashboard shows
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ClickUp (content-review sign-off gate) ---
# Personal API token. Used by the content-engine agents (and any review-task tooling)
# to create/read tasks on the "Content Review — Ewa" list (901218140081). Set in the
# cloud agent runtime; kept in .env.local for local dev. Rotate in ClickUp if leaked.
CLICKUP_API_TOKEN=

# --- Blog revalidation (DB-backed blog) ---
# Shared secret for POST /api/revalidate, sent as the `x-revalidate-secret` header.
# The blog_articles Supabase Database Webhook (and the Publisher agent) use it to
# refresh published/edited/archived articles with no Coolify redeploy. Route fails
# closed (401) when unset, so set this in Coolify before wiring the DB webhook.
REVALIDATE_SECRET=

# Shared token gating the draft preview route (/blog/preview/<slug>?token=...), the
# G2 sign-off review surface Ewa opens from the ClickUp task. Preview 404s when unset.
PREVIEW_SECRET=

# --- Stripe ---
# No publishable key: checkout is a server-side redirect to Stripe's hosted page
# (app/api/checkout/*), Stripe.js is never loaded in the browser, and
# @stripe/stripe-js is not a dependency. NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY was
# removed here and from the Dockerfile on 2026-09-15; nothing had ever read it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (copy from Stripe Dashboard → Catalogue → Products → [product] → Pricing)
STRIPE_PRICE_KIT_1=
STRIPE_PRICE_KIT_2=
STRIPE_PRICE_KIT_3=
STRIPE_PRICE_DAILY_STACK=
STRIPE_PRICE_COLLAGEN=
STRIPE_PRICE_COMPLETE_STACK=

# Read through a computed key, so a grep for `process.env.STRIPE_PRICE_BUNDLE_*`
# finds nothing: lib/bundles/config.ts names them and app/api/checkout/kit/route.ts
# does `process.env[bundleConfig.stripePriceEnv]`. Only used when BUNDLES_ENABLED.
STRIPE_PRICE_BUNDLE_CONFIRMATION=
STRIPE_PRICE_BUNDLE_PROVEIT=
STRIPE_PRICE_BUNDLE_FULLPICTURE=

# Optional member discount, also a computed key (lib/membership/memberPricing.ts).
# The discount is applied only when the coupon id is set.
STRIPE_COUPON_MEMBER=

# Stripe Coupon IDs for auto-applied ?discount= codes (Dashboard → Product catalogue → Coupons → [coupon] → copy ID).
# Mode-specific — set the LIVE coupon IDs in Coolify; leave blank locally so test checkouts stay full price.
STRIPE_COUPON_SUBSCRIBER10=
STRIPE_COUPON_LAUNCHDAY10=

# --- Vitall (lab partner) ---
# OAuth 2.0 credentials — obtain from Vitall onboarding
VITALL_CLIENT_ID=
VITALL_CLIENT_SECRET=
# Webhook signing token — obtain from Vitall; used to verify HMAC-256 signatures
VITALL_WEBHOOK_SECRET=
# Set to "true" to route all Vitall API calls to vitallsync.com sandbox
VITALL_SANDBOX=false

# --- Customer.io (email / CRM) ---
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=
CUSTOMERIO_APP_API_KEY=
# Track API region. EU is the DEFAULT in code (fail-safe: we are a UK controller and
# these events carry consent-gated health-derived traits). Set to "false" only to
# target the US data centre deliberately. MUST ALSO BE SET IN COOLIFY: it was absent
# there until 2026-08-04, which sent live production events via the US endpoints.
CUSTOMERIO_EU=true
# Internal ops alert recipient (lab-cancellation alert etc). Defaults to
# keith@andro-prime.com in code if unset.
OPS_ALERT_EMAIL=

# --- FirstPromoter (affiliate tracking) ---
FIRSTPROMOTER_API_KEY=
NEXT_PUBLIC_FIRSTPROMOTER_TRACKING_ID=

# --- Upstash QStash (webhook job queue) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Sentry (error monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Analytics ---
# Plausible was replaced by GA4 and no script tag for it survives anywhere in the
# app. NEXT_PUBLIC_PLAUSIBLE_DOMAIN was removed here and from the Dockerfile on
# 2026-09-15; it had been mounted as a build secret feeding nothing.
# GA4 server-side events (Measurement Protocol mirror — runs cookie-free, no consent)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# GA4 client-side tag (gtag.js, consent-gated). Same G-XXXX id as above; exposed to
# the browser (the measurement id is not secret). Leave unset to disable client GA
# entirely — the cookie banner then does not render. The api_secret is NEVER public.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Meta Conversions API (server-side events only)
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Link-in-bio grid for the 30-day Instagram carousel run (/go, lib/bio-grid.ts).
# When day 1 PUBLISHES. Bare date (2026-09-01, read as 00:00 UTC) or full ISO instant
# (2026-09-01T08:00:00Z). SET IT TO THE LATEST SLOT TIME YOU WILL EVER POST AT: tiles
# are revealed in whole 24h periods from this instant, so anchoring at midnight while
# posts go out at 08:00 shows every tile up to 8h before its carousel exists. Anchored
# late, a tile can only appear slightly late, which nobody notices.
# UNSET or future renders an empty grid rather than exposing the unposted schedule.
# Must be set in Coolify before the run starts, or the bio link lands on an empty page.
CAROUSEL_RUN_START=

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
#
# WHY THEY ARE LISTED HERE (added 2026-09-14, Direction F pre-migration audit).
# Ten flags gate live customer surfaces and NONE of them appeared in this file,
# so anyone configuring a deployment from it had no way to learn they exist.
# That is a documentation gap rather than a live defect, because every one is a
# strict `=== 'true'` check in lib/flags.ts: unset is provably OFF, and OFF is
# the intended state for all ten today. The danger is the inverse — a surface
# that is supposed to be ON silently is not, and nothing errors.
#
# Each flag's own doc comment in lib/flags.ts names what it gates and the exact
# conditions for switching it on. That file is the authority; this list exists
# so the flags are discoverable, and is deliberately terse to avoid becoming a
# second, staler copy of those conditions.
#
# Leave every one of these UNSET unless you are deliberately switching a surface
# on and its preconditions are met.

# Symptom overlay: the screen shown when every marker is in range and the man has
# said he still does not feel right. Copy signed as CA-048 + CA-049 Q5.
# 🔴 SETTING THIS TO true RENDERS NOTHING, and that is not a bug. No route mounts
# the component and nothing in the product writes the symptom answer it keys off,
# so the trigger can never be true. Building that capture is separate work and a
# compliance question of its own. See lib/flags.ts.
SYMPTOM_OVERLAY_ENABLED=
# Membership: /membership, /account/membership, subscription checkout, check-ins.
# Preconditions incl. a Stripe product AND the price id below. See lib/flags.ts.
MEMBERSHIP_ENABLED=
# Two-kit bundles: kit-page option, checkout branch, webhook insert, sweep job.
BUNDLES_ENABLED=
# Account "Delivery address" section and PUT /api/account/address (404s when off).
ACCOUNT_ADDRESS_ENABLED=
# Account "Data & privacy": results CSV export, data-use statement, erasure request.
ACCOUNT_DATA_CONTROLS_ENABLED=
# GP handoff pack: printable summary + questions, on GP-referral results.
GP_HANDOFF_ENABLED=
# "What this test did not tell you" kit-scope note on a normal-result Kit 1 card.
KIT_SCOPE_NOTE_ENABLED=
# Retest reminder: stamps the retest_due_at Customer.io attribute on an all-clear.
RETEST_REMINDER_ENABLED=
# Evidence disclosure block.
EVIDENCE_DISCLOSURE_ENABLED=
# All-clear maintenance offer. Read in lib/results/classifier.ts, NOT lib/flags.ts.
MAINTENANCE_OFFER_ENABLED=

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE — MEMBERSHIP PRICE
#
# The price id for the only `purchasable: true` subscription
# (lib/subscriptions/products.ts:45). `stripePriceIdFor()` returns null when it
# is unset, so membership checkout cannot resolve a price and the flow dies at
# the point of payment rather than at boot. lib/flags.ts:134 names it as
# switch-on precondition (c).
#
# Unset on 2026-09-14 in BOTH this file and .env.local — in .env.local it
# appears only inside a comment observing that it is unset, which is why a
# grep count finds it and a parse does not.
STRIPE_PRICE_MEMBERSHIP=
